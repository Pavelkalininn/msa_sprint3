@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Boundary(NovaMarket, "NovaMarket system") {

Container(Goods, "Goods microservice", "FastAPI", "Приложение для отображения товаров и их наличия")


Container(Reviews, "Reviews microservice", "FastAPI", "Приложение для отображения отзывов о товаре")

Container(Basket, "Basket microservice", "FastAPI", "Приложение для работы с корзиной")


Container(Delivery, "Delivery microservice", "FastAPI", "Приложение для работы с доставкой")
Container(SideDeliveryServie, "Side delivery service", "Стороннее приложение доставки")


Container(Purchase, "Purchase microservice", "FastAPI", "Приложение для работы с оплатой")


Container(Account, "Account microservice", "FastAPI", "Приложение для работы с аккаунтом пользователя")

Container(Notification, "Notification microservice", "FastAPI", "Приложение для работы с уведомлениями")



ComponentQueue(QueueGoodsToBasket, Топик событий добавления/удаления товара в/из корзины, Container: Apache Kafka)
Rel(Goods, QueueGoodsToBasket, "Публикует", "Kafka")
Rel(QueueGoodsToBasket, Basket, "Потребляет", "Kafka")


ComponentQueue(QueueGoodsReserve, Топик событий резервирования товара на складе, Container: Apache Kafka)
Rel(Basket, QueueGoodsReserve, "Публикует", "Kafka")
Rel(QueueGoodsReserve, Goods, "Потребляет", "Kafka")
Rel(Goods, QueueGoodsReserve, "Публикует", "Kafka")
Rel(QueueGoodsReserve, Basket, "Потребляет", "Kafka")
Rel(QueueGoodsReserve, Delivery, "Потребляет", "Kafka")
Rel(QueueGoodsReserve, Purchase, "Потребляет", "Kafka")


ComponentQueue(QueueCardSave, Топик событий сохранения карты, Container: Apache Kafka)
Rel(Purchase, QueueCardSave, "Публикует", "Kafka")
Rel(QueueCardSave, Account, "Потребляет", "Kafka")

ComponentQueue(QueueCardFetch, Топик событий запроса карты привязанной к аккаунту, Container: Apache Kafka)
Rel(QueueCardFetch, Purchase, "Потребляет", "Kafka")
Rel(Account, QueueCardFetch, "Публикует", "Kafka")


ComponentQueue(QueuePurchaseResult, Топик результата оплаты, Container: Apache Kafka)
Rel(Purchase, QueuePurchaseResult, "Публикует", "Kafka")
Rel(QueuePurchaseResult, Delivery, "Потребляет", "Kafka")
Rel(QueuePurchaseResult, Goods, "Потребляет", "Kafka")
Rel(QueuePurchaseResult, Notification, "Потребляет", "Kafka")



ComponentQueue(QueueSideDeliveryServie, Топик событий состояния доставки, Container: Apache Kafka)
Rel(SideDeliveryServie, QueueSideDeliveryServie, "Потребляет", "Kafka")
Rel(QueueSideDeliveryServie, Delivery, "Публикует", "Kafka")




